# ---------- Backend ----------
DATABASE_URL=sqlite:///./app.db
FRONTEND_URL=http://localhost:3000
# Optional extra allowed origins, comma separated (never use *)
EXTRA_CORS_ORIGINS=
ENVIRONMENT=development
LOG_LEVEL=INFO
MAX_UPLOAD_BYTES=2097152

# Optional LLM (app works fully without these; heuristic AI is used instead)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ---------- Frontend ----------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
